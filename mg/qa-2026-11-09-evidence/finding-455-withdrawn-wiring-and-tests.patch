+  // Finding 455 (QA of 2026-11-09): a dedicated worker's WebSocket never reached the judge, and a
+  // socket to a refused host connected. Judged now as the page's own sockets are.
+  async function workerSocket(path = "/worker-socket") {
+    const { page } = await boundPage();
+    await page.goto(`${base}${path}`);
+    await page.waitForFunction(() => (window as { result?: string }).result !== "pending", null, {
+      timeout: 10_000,
+    });
+    await settle(page, 300);
+    return {
+      result: await page.evaluate(() => (window as { result?: string }).result),
+      upgraded: received.some((entry) => entry.includes("/ws-from-worker (upgrade)")),
+    };
+  }
+
+  it("judges a worker's WebSocket and refuses it before it connects (finding 455)", async () => {
+    refuse = (url) => url.startsWith("ws://");
+    const { result, upgraded } = await workerSocket();
+    require("node:fs").writeFileSync(process.env.QA_PROBE_OUT ?? "diag.txt", JSON.stringify({ result, upgraded, received, diag: (globalThis as Record<string, unknown>).__QA_WS_DIAG }, null, 1));
+    expect(result).toBe("closed");
+    expect(upgraded).toBe(false);
+    expect(judged).toContainEqual({
+      url: `${otherBase.replace("http", "ws")}/ws-from-worker`,
+      via: "page",
+      agentId: "demo",
+    });
+  });
+
+  it("lets a worker's WebSocket no denial names connect, as before (finding 455)", async () => {
+    const { upgraded } = await workerSocket();
+    expect(upgraded).toBe(true);
+  });
+
+  it("ignores a verdict the worker's own script forges (finding 455)", async () => {
+    refuse = (url) => url.startsWith("ws://");
+    const { result, upgraded } = await workerSocket("/worker-socket-forge");
+    expect(result).toBe("closed");
+    expect(upgraded).toBe(false);
+  });
+
